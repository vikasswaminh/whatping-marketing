---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_URL } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Overrides the default JSON-LD block. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WhatPing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* summary_large_image without an image renders every share as a blank card. The PNG is
        generated from /og/ by scripts/build-og.py, so it is built from the same tokens as
        the site. Absolute URL because crawlers do not resolve relative ones. */}
    <meta property="og:image" content={new URL("/og.png", SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="WhatPing — uptime monitoring that also watches your certificate, domain, DNS and SPF"
    />
    <meta name="twitter:image" content={new URL("/og.png", SITE_URL).href} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fffaeb" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23fffaeb'/%3E%3Crect x='6' y='14' width='3' height='10' fill='%23ff8205'/%3E%3Crect x='12' y='9' width='3' height='15' fill='%23ff8205'/%3E%3Crect x='18' y='6' width='3' height='18' fill='%23e10500'/%3E%3Crect x='24' y='12' width='3' height='12' fill='%23ff8205'/%3E%3C/svg%3E"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
