---
import DocsSidebar from "../components/DocsSidebar.astro";
import { DOCS_FLAT } from "../lib/site";
import Base from "./Base.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  headings?: Heading[];
  /** Passed straight through to Base. Used by the FAQ for FAQPage markup. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, h1, headings = [], jsonLd } = Astro.props;

// Only h2s. An "on this page" rail that mirrors every heading level stops being a map.
const toc = headings.filter((h) => h.depth === 2);

const path = Astro.url.pathname;
const index = DOCS_FLAT.findIndex((item) => item.href === path);
const prev = index > 0 ? DOCS_FLAT[index - 1] : undefined;
const next =
  index >= 0 && index < DOCS_FLAT.length - 1 ? DOCS_FLAT[index + 1] : undefined;
---

<Base title={title} description={description} jsonLd={jsonLd} rail={false}>
  {/* The manual. `.band--paper` remaps the semantic tokens, so every component
      inside — sidebar, prose, callouts, pills — works unchanged on a light
      ground. Full-bleed, with console chrome above and below it. */}
  <div class="band--paper docs-band">
    <div class="shell docs">
      <DocsSidebar />

      <div class="docs-main">
        <div class="page-head">
          <p class="eyebrow">Documentation</p>
          <h1>{h1}</h1>
        </div>

        <article class="prose">
          <slot />
        </article>

        {
          (prev || next) && (
            <nav class="docs-nextprev" aria-label="Pagination">
              {prev ? (
                <a href={prev.href}>
                  <span>Previous</span>
                  {prev.label}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={next.href} style="text-align:right">
                  <span>Next</span>
                  {next.label}
                </a>
              )}
            </nav>
          )
        }
      </div>

      {
        toc.length > 1 && (
          <nav class="docs-toc" aria-label="On this page">
            <h2>On this page</h2>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</Base>
