---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  h1: string;
  eyebrow?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, h1, eyebrow = "WhatPing", jsonLd } = Astro.props;
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="shell">
    <div class="page-head">
      <div class="hero-eyebrow">
        <span class="square-dot"></span> {eyebrow}
        <span class="eyebrow-line"></span>
      </div>
      <h1>{h1}</h1>
    </div>

    <article class="prose">
      <slot />
    </article>
  </div>
</Base>
