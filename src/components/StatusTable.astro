---
<div class="live-cards-container">
  {services.map((s) => (
    <div class="live-card">
      <div class="live-card-service">
        <div class={`live-card-iconBox ${s.iconBox}`} set:html={s.icon}></div>
        <div class="live-card-text">
          <div class="live-card-name">{s.name}</div>
          <div class="live-card-domain">{s.domain}</div>
        </div>
      </div>
      
      <div class="live-card-status">
        <span class="live-status-pill live-status-pill--up">
          <span class="live-status-dot-green"></span>
          {s.status}
        </span>
      </div>
      
      <div class="live-card-latency">
        {s.latency}
      </div>
      
      <div class="live-card-location">
        <span class="live-card-flag" set:html={s.flag}></span>
        {s.location}
      </div>
      
      <div class="live-card-actions">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
      </div>
    </div>
  ))}
</div>
