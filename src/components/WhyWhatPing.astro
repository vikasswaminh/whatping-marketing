---
const benefits = [
  {
    image: "/images/why_global.jpg",
    title: "Global Network",
    description: "Probes distributed across major clouds and geographies for neutral external verification."
  },
  {
    image: "/images/why_alerts.jpg",
    title: "Real-time Alerts",
    description: "High-speed dispatching to Slack, Telegram, webhooks, and email before your clients notice."
  },
  {
    image: "/images/why_intelligent.jpg",
    title: "Intelligent Monitoring",
    description: "Built-in validation checks, automatic secondary confirmations, and AI-assisted troubleshooting."
  },
  {
    image: "/images/why_reports.jpg",
    title: "Reports & Insights",
    description: "Automated analysis of availability ranges, certificate lifespans, and SPF record setups."
  }
];
---
<section class="homepage-section" id="why-whatping">
  <div class="container">
    <h2 class="section-title">Why WhatPing?</h2>
    <p class="section-subtitle">A stateless, resilient infrastructure designed to give you precise signals without false positives.</p>
    
    <div class="why-grid">
      {benefits.map((b) => (
        <div class="card feat-card why-item">
          <div class="feat-card__img-wrap">
            <img src={b.image} alt={b.title} class="feat-card__img" />
          </div>
          <h3 class="feat-card__h">{b.title}</h3>
          <p class="feat-card__p">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
