---
/**
 * Bento grid.
 *
 * Cells are sized by importance rather than uniformly: the two monitor types nothing else in
 * the category does — domain expiry and email auth — take double width, which is the grid
 * doing editorial work instead of just tiling.
 */
interface Cell {
  tag: string;
  title: string;
  body: string;
  href: string;
  /** Double-width. Reserved for the differentiators. */
  wide?: boolean;
  accent?: boolean;
}

interface Props {
  cells: Cell[];
}

const { cells } = Astro.props;
---

<div class="bento">
  {
    cells.map((cell, i) => (
      <a
        class={`bento__cell${cell.wide ? " bento__cell--wide" : ""}${cell.accent ? " bento__cell--accent" : ""} reveal`}
        href={cell.href}
        style={`--i:${i}`}
      >
        <span class="bento__tag">{cell.tag}</span>
        <h3 class="bento__title">{cell.title}</h3>
        <p class="bento__body">{cell.body}</p>
        <span class="bento__more" aria-hidden="true">→</span>
      </a>
    ))
  }
</div>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2xs);
  }

  .bento__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    text-decoration: none;
    overflow: hidden;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .bento__cell:hover {
    background: var(--surface-overlay);
    border-color: var(--hairline-strong);
    transform: translateY(-2px);
  }

  .bento__cell--wide {
    grid-column: span 2;
  }

  /* The differentiators get a hairline in the accent rather than a fill — one accent used
     sparingly is the whole discipline. */
  .bento__cell--accent {
    border-color: var(--accent-line);
  }
  .bento__cell--accent:hover {
    border-color: var(--accent);
  }

  .bento__tag {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    font-weight: var(--weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-quaternary);
  }
  .bento__cell--accent .bento__tag {
    color: var(--accent);
  }

  .bento__title {
    margin: var(--space-xs) 0 var(--space-3xs);
    font-size: var(--size-body-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-title);
    color: var(--text-primary);
    line-height: 1.25;
  }

  .bento__body {
    margin: 0;
    font-size: var(--size-small);
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .bento__more {
    margin-top: var(--space-sm);
    font-size: var(--size-small);
    color: var(--text-quaternary);
    transition: color var(--duration-fast) var(--ease);
  }
  .bento__cell:hover .bento__more {
    color: var(--accent);
  }

  @media (max-width: 62rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__cell--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 34rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .bento__cell--wide {
      grid-column: span 1;
    }
  }
</style>
