---
---
<div class="global-constellation-container">
  <canvas id="global-constellation-canvas" class="global-constellation-canvas-el"></canvas>
</div>

<style>
  .global-constellation-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .global-constellation-canvas-el {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.6; /* Slightly lower opacity so it doesn't overpower text across the whole page */
  }
</style>

<script>
  const canvas = document.getElementById('global-constellation-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width: number;
      let height: number;
      let particles: Particle[] = [];
      
      class Particle {
        angle: number;
        dist: number;
        speed: number;
        radius: number;
        glow: boolean;
        isAccent: boolean;

        constructor(w: number, h: number, initialRandomize: boolean = true) {
          this.angle = Math.random() * Math.PI * 2;
          // If initializing, scatter them everywhere. Otherwise, start near the center.
          const maxDist = Math.max(w, h) / 1.5;
          this.dist = initialRandomize ? Math.random() * maxDist : Math.random() * 50;
          this.speed = Math.random() * 0.4 + 0.1; // Slow continuous outward speed
          
          const rand = Math.random();
          if (rand > 0.92) {
            // 8% large glowing yellow
            this.radius = Math.random() * 8 + 6;
            this.glow = true;
            this.isAccent = true;
          } else if (rand > 0.70) {
            // 22% medium, 80% of them yellow
            this.radius = Math.random() * 3 + 2;
            this.glow = false;
            this.isAccent = Math.random() > 0.2;
          } else {
            // 70% small, 40% of them yellow
            this.radius = Math.random() * 1.5 + 0.5;
            this.glow = false;
            this.isAccent = Math.random() > 0.6;
          }
        }

        update(w: number, h: number) {
          // Move outwards continuously
          this.dist += this.speed;
          
          // Slight rotational drift for organic movement
          this.angle += 0.0005;

          const maxDist = Math.max(w, h) / 1.2;
          
          // Loop back to center when they go too far off screen
          if (this.dist > maxDist) {
             this.reset(w, h);
          }
        }
        
        reset(w: number, h: number) {
          this.angle = Math.random() * Math.PI * 2;
          this.dist = Math.random() * 20; // Respawn near center
        }

        getRenderPos(w: number, h: number) {
          const centerX = w / 2;
          const centerY = h / 2;
          return {
            x: centerX + Math.cos(this.angle) * this.dist,
            y: centerY + Math.sin(this.angle) * this.dist
          };
        }
      }

      const init = () => {
        const rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;
        ctx.resetTransform();
        ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        
        particles = [];
        const numParticles = Math.floor((width * height) / 9000); 
        for (let i = 0; i < numParticles; i++) {
          particles.push(new Particle(width, height, true));
        }
      };

      const animate = () => {
        ctx.clearRect(0, 0, width, height);

        particles.forEach(p => p.update(width, height));
        const renderPositions = particles.map(p => p.getRenderPos(width, height));

        // Draw connections
        ctx.lineWidth = 0.5;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const p1 = renderPositions[i];
            const p2 = renderPositions[j];
            
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            const distSq = dx * dx + dy * dy;
            
            // Connect dots that are close to each other
            const maxDist = 160; 
            
            if (distSq < maxDist * maxDist) {
              const alpha = (1 - Math.sqrt(distSq) / maxDist) * 0.4;
              ctx.strokeStyle = `rgba(200, 180, 140, ${alpha})`;
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.stroke();
            }
          }
        }

        // Draw nodes
        particles.forEach((p, i) => {
          const pos = renderPositions[i];
          
          // Fade in particles as they emerge from the center so they don't pop abruptly
          const opacityFade = Math.min(1, p.dist / 100); 

          ctx.beginPath();
          ctx.arc(pos.x, pos.y, p.radius, 0, Math.PI * 2);
          
          if (p.isAccent) {
            ctx.fillStyle = `rgba(249, 185, 0, ${0.85 * opacityFade})`;
            if (p.glow) {
              ctx.shadowBlur = 20;
              ctx.shadowColor = `rgba(249, 185, 0, ${0.7 * opacityFade})`;
            } else {
              ctx.shadowBlur = 0;
            }
          } else {
            ctx.fillStyle = `rgba(80, 80, 80, ${0.35 * opacityFade})`;
            ctx.shadowBlur = 0;
          }
          
          ctx.fill();
        });
        
        ctx.shadowBlur = 0;

        requestAnimationFrame(animate);
      };

      window.addEventListener('resize', init);
      init();
      animate();
    }
  }
</script>
