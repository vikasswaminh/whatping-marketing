---
import StatusTable from "./StatusTable.astro";
import { APP_URL } from "../lib/site";
---
<section class="homepage-section" id="live-monitoring">
  <div class="container">
    <div class="live-header">
      <h2 class="section-title">Live <span style="color: var(--accent)">system</span> monitoring</h2>
      <p class="section-subtitle">A live feed of checking operations, latencies, and reachability across our global edge nodes.</p>
    </div>
    
    <div class="live-grid">
      <!-- Left: Orb -->
      <div class="live-orb-wrapper">
        <div class="live-orb">
          <div class="orb-ring orb-ring-1"></div>
          <div class="orb-ring orb-ring-2"></div>
          <div class="orb-ring orb-ring-3"></div>
          
          <div class="live-orb-inner">
            <svg class="orb-icon" viewBox="0 0 48 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 64px; height: 32px;">
              <path d="M 4 12 L 16 12 L 20 4 L 26 20 L 30 12 L 44 12" />
            </svg>
            <h3 class="orb-title">ALL SYSTEMS<br/><span class="orb-title-accent">OPERATIONAL</span></h3>
            <div class="orb-success">
              <span class="live-status-dot live-status-dot--pulse"></span>
              100% success rate
            </div>
          </div>
        </div>
        <a href="/roadmap/" class="orb-cta">
          <span style="transform: translateY(-1px);">View Status Page</span>
          <svg style="transform: translateY(-1px);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Right: Status Cards -->
      <div class="live-status-list">
        <div class="live-list-header">
          <span></span>
          <span>STATUS</span>
          <span>RESPONSE</span>
          <span>LOCATION</span>
        </div>
        <StatusTable />
      </div>
    </div>
  </div>
</section>

