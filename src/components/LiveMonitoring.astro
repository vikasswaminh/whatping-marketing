---
import StatusTable from "./StatusTable.astro";
import { APP_URL } from "../lib/site";
---
<section class="homepage-section" id="live-monitoring">
  <div class="container">
    <div class="live-header">
      <h2 class="section-title">Live <span class="accent-text" style="background: linear-gradient(135deg, #FF8C00 0%, #F9B900 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">system</span> monitoring</h2>
      <p class="section-subtitle">A live feed of checking operations, latencies, and reachability across our global edge nodes.</p>
    </div>
    
    <div class="live-grid-new">
      <!-- Left Box -->
      <div class="live-box live-box-left">
        <div class="live-status-badge">
          <span class="live-status-dot-green"></span> All Systems Operational
        </div>
        
        <div class="live-orb-container">
          <div class="live-orb-outer">
            <div class="live-orb-middle">
              <div class="live-orb-inner-content">
                <div class="live-check-icon">
                  <svg viewBox="0 0 24 24" fill="#03A651"><circle cx="12" cy="12" r="12"/><path fill="#FFF" d="M10.2 16.2L6 12l1.4-1.4 2.8 2.8 6.4-6.4L18 8z"/></svg>
                </div>
                <div class="live-orb-text1">ALL SYSTEMS</div>
                <div class="live-orb-text2">OPERATIONAL</div>
                <div class="live-orb-text3">100% success rate</div>
              </div>
            </div>
          </div>
        </div>

        <div class="live-stats-grid">
          <div class="live-stat-item">
            <div class="live-stat-label">Total Services</div>
            <div class="live-stat-value">6</div>
          </div>
          <div class="live-stat-item">
            <div class="live-stat-label">Up</div>
            <div class="live-stat-value live-stat-up">6</div>
          </div>
          <div class="live-stat-item">
            <div class="live-stat-label">Down</div>
            <div class="live-stat-value live-stat-down">0</div>
          </div>
          <div class="live-stat-item">
            <div class="live-stat-label">Avg. Response</div>
            <div class="live-stat-value">112ms</div>
          </div>
        </div>

        <a href="/roadmap/" class="btn btn--primary live-box-cta" style="width: 100%;">
          View Status Page &rarr;
        </a>
      </div>

      <!-- Right Box -->
      <div class="live-box live-box-right">
        <div class="live-right-header">
          <div class="live-right-title-group">
            <h3 class="live-right-title">Services</h3>
            <div class="live-right-title-line"></div>
          </div>
          <div class="live-right-controls">
            <div class="live-right-summary">
              <span class="live-status-dot-green"></span> <span class="live-summary-text">6 Up</span>
              <span class="live-status-dot-red" style="margin-left:16px;"></span> <span class="live-summary-text">0 Down</span>
            </div>
            <div class="live-location-dropdown">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="live-globe-icon"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/><path d="M2 12h20"/></svg>
              All Locations
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="live-chevron-icon"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
        </div>

        <div class="live-table-header">
          <div class="th-service">SERVICE</div>
          <div class="th-status">STATUS</div>
          <div class="th-response">RESPONSE TIME</div>
          <div class="th-location">LOCATION</div>
        </div>
        
        <StatusTable />
      </div>
    </div>
  </div>
</section>
