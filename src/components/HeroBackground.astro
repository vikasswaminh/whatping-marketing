---
---
<div class="constellation-container">
  <canvas id="constellation-canvas" class="constellation-canvas-el"></canvas>
</div>

<style>
  .constellation-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 70%, rgba(0,0,0,0) 100%);
  }
  .constellation-canvas-el {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.8;
  }
</style>

<script>
  const canvas = document.getElementById('constellation-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width: number;
      let height: number;
      let particles: Particle[] = [];
      
      let targetScrollOffset = 0;
      let currentScrollOffset = 0;

      window.addEventListener('scroll', () => {
        // Max scroll effect is reached after 600px of scrolling down
        let p = window.scrollY / 600;
        if (p < 0) p = 0;
        if (p > 1) p = 1;
        targetScrollOffset = p;
      });

      class Particle {
        baseX: number;
        baseY: number;
        vx: number;
        vy: number;
        radius: number;
        glow: boolean;
        isAccent: boolean;

        constructor(w: number, h: number) {
          this.baseX = Math.random() * w;
          this.baseY = Math.random() * h;
          // Very slow baseline drift
          this.vx = (Math.random() - 0.5) * 0.4;
          this.vy = (Math.random() - 0.5) * 0.4;
          
          const rand = Math.random();
          if (rand > 0.96) {
            this.radius = Math.random() * 12 + 8; // Large
            this.glow = true;
            this.isAccent = true;
          } else if (rand > 0.85) {
            this.radius = Math.random() * 5 + 3; // Medium
            this.glow = false;
            this.isAccent = Math.random() > 0.5;
          } else {
            this.radius = Math.random() * 1.5 + 0.5; // Small
            this.glow = false;
            this.isAccent = false;
          }
        }

        update(w: number, h: number) {
          this.baseX += this.vx;
          this.baseY += this.vy;

          if (this.baseX < 0 || this.baseX > w) this.vx *= -1;
          if (this.baseY < 0 || this.baseY > h) this.vy *= -1;
        }

        getRenderPos(w: number, h: number, scrollOffset: number) {
          const centerX = w / 2;
          const centerY = h / 2;
          
          // Calculate vector from center to this particle
          const dx = this.baseX - centerX;
          const dy = this.baseY - centerY;
          
          // As scrollOffset increases, push particles outward significantly
          // The multiplier (e.g. 1.5) determines how far apart they spread
          const expansionFactor = scrollOffset * 1.5; 
          
          return {
            x: this.baseX + dx * expansionFactor,
            y: this.baseY + dy * expansionFactor
          };
        }
      }

      const init = () => {
        const rect = canvas.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas.width = width * window.devicePixelRatio;
        canvas.height = height * window.devicePixelRatio;
        ctx.resetTransform();
        ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
        
        particles = [];
        const numParticles = Math.floor((width * height) / 10000); 
        for (let i = 0; i < numParticles; i++) {
          particles.push(new Particle(width, height));
        }
      };

      const animate = () => {
        ctx.clearRect(0, 0, width, height);

        // LERP the scroll offset for smooth, elastic expansion and contraction
        currentScrollOffset += (targetScrollOffset - currentScrollOffset) * 0.08;

        // Update baseline positions
        particles.forEach(p => p.update(width, height));

        // Get actual rendered positions based on scroll
        const renderPositions = particles.map(p => p.getRenderPos(width, height, currentScrollOffset));

        // Draw connections
        ctx.lineWidth = 0.6;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const p1 = renderPositions[i];
            const p2 = renderPositions[j];
            
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            const distSq = dx * dx + dy * dy;
            
            // Maximum distance for a line to be drawn
            const maxDist = 180; 
            
            if (distSq < maxDist * maxDist) {
              const alpha = 1 - Math.sqrt(distSq) / maxDist;
              ctx.strokeStyle = `rgba(200, 180, 140, ${alpha * 0.5})`;
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.stroke();
            }
          }
        }

        // Draw nodes
        particles.forEach((p, i) => {
          const pos = renderPositions[i];
          ctx.beginPath();
          ctx.arc(pos.x, pos.y, p.radius, 0, Math.PI * 2);
          
          if (p.isAccent) {
            ctx.fillStyle = `rgba(249, 185, 0, 0.95)`;
            if (p.glow) {
              ctx.shadowBlur = 24;
              ctx.shadowColor = `rgba(249, 185, 0, 0.8)`;
            } else {
              ctx.shadowBlur = 0;
            }
          } else {
            ctx.fillStyle = `rgba(80, 80, 80, 0.4)`;
            ctx.shadowBlur = 0;
          }
          
          ctx.fill();
        });
        
        ctx.shadowBlur = 0;

        requestAnimationFrame(animate);
      };

      window.addEventListener('resize', init);
      init();
      animate();
    }
  }
</script>
