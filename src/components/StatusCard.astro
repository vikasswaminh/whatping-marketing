---
import Heartbeat from "./Heartbeat.astro";

/**
 * The hero visual: a real monitor list, not an abstract shape.
 *
 * Built from the same tokens as the rest of the page, so it is the product's actual interface
 * vocabulary rather than a picture of it. Every row here is a monitor type that exists, and
 * the failure text is the literal string the product sends.
 *
 * Rows arrive in sequence on load — a panel coming up, not a card fading in. The stagger is
 * short enough to read as a boot and not as a delay, and it is off entirely under
 * prefers-reduced-motion.
 */

const rows = [
  { name: "api", target: "api.example.com", state: "up", meta: "182 ms" },
  { name: "checkout", target: "shop.example.com", state: "up", meta: "240 ms" },
  { name: "example.com registration", target: "registry", state: "warn", meta: "21 days" },
  { name: "postgres", target: "db.example.com:5432", state: "down", meta: "connection refused" },
  { name: "nightly-backup", target: "heartbeat", state: "up", meta: "3h ago" },
  { name: "example.com SPF + DMARC", target: "email auth", state: "up", meta: "ok" },
] as const;

const label = { up: "UP", down: "DOWN", warn: "WARN" } as const;
---

<figure class="status">
  <figcaption class="status__head">
    <span class="status__dot" aria-hidden="true"></span>
    <span>Monitors</span>
    <span class="status__count">6</span>
  </figcaption>

  <ul class="status__list">
    {
      rows.map((row, i) => (
        <li class="status__row" style={`--i:${i}`}>
          <span class={`pill pill--${row.state} status__pill`}>{label[row.state]}</span>
          <span class="status__name">{row.name}</span>
          <span class="status__target">{row.target}</span>
          <span class={`status__meta status__meta--${row.state}`}>{row.meta}</span>
        </li>
      ))
    }
  </ul>

  <div class="status__foot">
    <Heartbeat count={40} down={[30, 31]} warn={[29, 32]} height="1.5rem" delay={0.35} />
    <p>
      <span class="status__foot-label">postgres</span>
      <span>down 4m · confirmed unreachable from a second network</span>
    </p>
  </div>
</figure>

<style>
  .status {
    margin: 0;
    background: var(--surface-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    overflow: hidden;
    font-size: var(--size-small);
  }

  .status__head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--hairline-strong);
    background: var(--surface-overlay);
    font-family: var(--font-display);
    font-stretch: var(--width-ui);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .status__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-xs);
    background: var(--status-up);
  }
  .status__count {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--text-quaternary);
  }

  .status__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .status__row {
    display: grid;
    grid-template-columns: 3.9rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    padding: 0.6rem var(--space-sm);
    border-bottom: 1px solid var(--hairline);
    animation: row-boot 0.42s var(--ease) both;
    animation-delay: calc(0.07s * var(--i) + 0.12s);
  }
  .status__row:last-child {
    border-bottom: 0;
  }
  /* Rows arrive from the left, the way a list populates as records come back —
     rather than fading up, which is how a card animates. */
  @keyframes row-boot {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  /* Sizing only — colour and shape come from the shared .pill rule. */
  .status__pill {
    justify-content: center;
    font-size: 0.625rem;
  }

  .status__name {
    color: var(--text-primary);
    font-weight: var(--weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status__target {
    grid-column: 2;
    grid-row: 2;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status__meta {
    grid-row: 1 / span 2;
    grid-column: 3;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-tertiary);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .status__meta--down {
    color: var(--status-down);
  }
  .status__meta--warn {
    color: var(--status-warn);
  }

  .status__foot {
    padding: var(--space-sm);
    border-top: 1px solid var(--hairline-strong);
    background: var(--surface-sunken);
  }
  .status__foot p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-2xs) 0 0;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary);
  }
  .status__foot-label {
    color: var(--status-down);
  }

  @media (prefers-reduced-motion: reduce) {
    .status__row {
      animation: none;
    }
  }
</style>
