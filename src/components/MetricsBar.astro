<section class="metrics-bar">
  <div class="container metrics-grid">
    <div class="metric-item">
      <span class="metric-val">10M+</span>
      <span class="metric-label">Checks/day</span>
    </div>
    
    <div class="metric-item">
      <span class="metric-val">99.999%</span>
      <span class="metric-label">Uptime SLA</span>
    </div>

    <div class="metric-item">
      <span class="metric-val">100+</span>
      <span class="metric-label">Geolocations</span>
    </div>

    <div class="metric-item">
      <span class="metric-val">&lt;1.5s</span>
      <span class="metric-label">Alert Dispatch</span>
    </div>

    <div class="metric-item">
      <span class="metric-val">5K+</span>
      <span class="metric-label">Monitors Saved</span>
    </div>
  </div>
</section>
