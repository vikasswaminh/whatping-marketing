---
import MonitoringTypeCard from "./MonitoringTypeCard.astro";

const types = [
  {
    icon: "🌐",
    title: "HTTP(s) Monitoring",
    description: "Status ranges, keyword matching, and payload assertions."
  },
  {
    icon: "🔒",
    title: "SSL Certificates",
    description: "Days until TLS expiry and validity alerts."
  },
  {
    icon: "📡",
    title: "Ping Monitoring",
    description: "Unprivileged ICMP checks for packet loss and median RTT."
  },
  {
    icon: "🔎",
    title: "DNS Monitoring",
    description: "Assert A, AAAA, MX, TXT, and CNAME records."
  },
  {
    icon: "🚪",
    title: "Port Monitoring",
    description: "Test direct TCP connections on custom ports."
  },
  {
    icon: "🚀",
    title: "UDP Monitoring",
    description: "Send custom payloads over UDP and require valid responses."
  },
  {
    icon: "📅",
    title: "Domain Expiry",
    description: "Check registration status and days remaining against registries."
  },
  {
    icon: "🛡️",
    title: "Email Auth (SPF/DMARC)",
    description: "Verify daily that SPF and DMARC records remain published."
  },
  {
    icon: "⚡",
    title: "gRPC Monitoring",
    description: "Call standard grpc.health.v1.Health/Check for serving status."
  },
  {
    icon: "💓",
    title: "Heartbeat Monitoring",
    description: "Monitor cron jobs and pipelines by having them ping a URL."
  },
  {
    icon: "📨",
    title: "Mail Monitoring",
    description: "Read mail server greetings and complete STARTTLS handshakes."
  }
];
---
<section class="homepage-section" id="monitoring-types">
  <div class="container">
    <h2 class="section-title">What can you monitor?</h2>
    <p class="section-subtitle">We support a wide array of checks spanning multiple protocols, layers, and service types.</p>
    
    <div class="types-grid">
      {types.map((t) => (
        <MonitoringTypeCard icon={t.icon} title={t.title} description={t.description} />
      ))}
    </div>
  </div>
</section>
