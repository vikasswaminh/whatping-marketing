---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---
<div class="card feat-card">
  <span class="feat-card__icon">{icon}</span>
  <h3 class="feat-card__h">{title}</h3>
  <p class="feat-card__p">{description}</p>
</div>
