---
interface Props {
  label: string;
  href: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { label, href, secondaryLabel, secondaryHref } = Astro.props;
---

<p class="cta-row">
  <a class="cta" href={href}>{label}</a>
  {
    secondaryLabel && secondaryHref && (
      <a class="cta cta--ghost" href={secondaryHref}>
        {secondaryLabel}
      </a>
    )
  }
</p>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem !important;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
</style>
