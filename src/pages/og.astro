---
/**
 * The Open Graph card, as a page.
 *
 * Rendered rather than drawn, so it is built from the same tokens as the site and cannot
 * drift from the palette the way an exported image does. `scripts/build-og.py` screenshots
 * this at exactly 1200x630 and writes public/og.png; nothing else consumes it.
 *
 * Excluded from the sitemap in astro.config.mjs and marked noindex here — it is a build
 * input that happens to be reachable, not a page.
 */
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>WhatPing</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="og-body">
    <div class="card">
      <div class="row">
        <span class="dot"></span>
        <span class="word">WhatPing</span>
      </div>

      <h1>
        The outage that returns <span class="readout"
          ><span class="readout__label">HTTP</span><span class="readout__value">200</span
          ><span class="readout__caret"></span></span
        > right up until it doesn&rsquo;t
      </h1>

      <p class="sub">
        Certificate, domain, DNS and SPF monitoring — alongside HTTP, TCP, ping, UDP,
        gRPC and cron heartbeats.
      </p>

      <div class="feet">
        <span class="pill pill--up">UP</span>
        <span class="pill pill--warn">WARN</span>
        <span class="pill pill--down">DOWN</span>
        <span class="host">whatping.com</span>
      </div>
    </div>
  </body>
</html>

<style>
  /* No grain and no scan lines on the card. They are a live-surface effect, and
     on a static PNG they only defeat the compressor: keeping them took og.png
     from 95KB to 484KB for texture nobody sees at thumbnail size. */
  .og-body::before,
  .og-body::after {
    display: none;
  }

  /* Fixed pixel sizing on purpose: this is a 1200x630 canvas, not a responsive page. */
  .og-body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .card {
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 72px 80px;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(60rem 34rem at 18% -14%, var(--accent-glow), transparent 60%),
      var(--surface-canvas);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-xs);
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-glow);
  }
  .word {
    font-family: var(--font-display);
    font-stretch: var(--width-ui);
    font-size: 24px;
    font-weight: var(--weight-strong);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  h1 {
    margin: 40px 0 0;
    max-width: 19ch;
    font-family: var(--font-display);
    font-stretch: var(--width-display);
    font-weight: var(--weight-display);
    font-size: 60px;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  /* Same readout as the hero. The card is generated from this page precisely so
     the two cannot drift. The caret does not blink here — it is a still. */
  .readout {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.06em 0.42em 0.1em;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-xs);
    background: var(--accent-soft);
    font-size: 0.74em;
    translate: 0 0.04em;
  }
  .readout__label {
    font-family: var(--font-mono);
    font-size: 0.5em;
    letter-spacing: 0.16em;
    color: var(--text-quaternary);
  }
  .readout__value {
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    letter-spacing: -0.02em;
    color: var(--accent-text);
  }
  .readout__caret {
    width: 0.42em;
    height: 0.92em;
    background: var(--accent);
  }

  .sub {
    margin: 28px 0 0;
    max-width: 50ch;
    font-size: 25px;
    line-height: 1.45;
    color: var(--text-tertiary);
  }

  .feet {
    /* `auto` pushes the row to the bottom when there is slack; the padding guarantees a gap
       above it when there is not, which is the case that looked wrong. */
    margin-top: auto;
    padding-top: 36px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .feet .pill {
    font-size: 18px;
  }
  .host {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--text-quaternary);
  }
</style>
