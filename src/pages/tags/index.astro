---
import BaseLayout from '../../layouts/blog/BaseLayout.astro';
import { getPublishedPosts, readingTime } from '../../utils/posts';

const posts = await getPublishedPosts();

// Group posts by tag
const tagMap = new Map<string, typeof posts>();
for (const p of posts) {
  if (p.data.tags && Array.isArray(p.data.tags)) {
    for (const t of p.data.tags) {
      const existing = tagMap.get(t) || [];
      existing.push(p);
      tagMap.set(t, existing);
    }
  }
}

// Extract specials and standard tags
const allTags = [...tagMap.keys()].sort((a, b) => {
  if (a === 'founder-special') return -1;
  if (b === 'founder-special') return 1;
  if (a === 'performance-special') return -1;
  if (b === 'performance-special') return 1;
  return (tagMap.get(b)?.length || 0) - (tagMap.get(a)?.length || 0);
});

const specialTags = ['founder-special', 'performance-special'];
const topicTags = allTags.filter((t) => !specialTags.includes(t));
---

<BaseLayout title="All Topics & Specials | WhatPing Blog" description="Browse all technical uptime monitoring guides and specials by topic.">
  <div class="tags-container">
    
    <!-- HEADER -->
    <header class="tags-header">
      <div class="tags-eyebrow">
        <span class="square-dot"></span>
        <span>TOPICS & SPECIALS</span>
        <span class="eyebrow-line"></span>
      </div>
      <h1>Topics & Special Collections</h1>
      <p class="tags-subtitle">
        Explore technical guides, system architecture breakdowns, and uptime strategy posts organized by topic.
      </p>
      
      <div class="tags-stats-bar">
        <div class="stat-item">
          <span class="stat-num">{allTags.length}</span>
          <span class="stat-lbl">Active Topics</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">{posts.length}</span>
          <span class="stat-lbl">Published Guides</span>
        </div>
      </div>
    </header>

    <!-- SPECIAL COLLECTIONS SECTION -->
    <section class="specials-section">
      <div class="section-header-row">
        <h2 class="section-heading">Featured Specials</h2>
        <button class="swipe-indicator" id="swipe-btn">Swipe &rarr;</button>
      </div>
      <div class="specials-grid">
        
        <!-- FOUNDER'S PLAYBOOK -->
        {tagMap.has('founder-special') && (
          <div class="special-card special-card--orange">
            <div class="special-card-header">
              <span class="badge-pill badge-pill--orange">FOUNDER'S PLAYBOOK</span>
              <span class="count-pill">{tagMap.get('founder-special')?.length} Articles</span>
            </div>
            <h3>Founder & Executive Guides</h3>
            <p>High-level tool comparisons, check frequency math, SLA protection, and e-commerce reliability checklists.</p>
            
            <ul class="special-post-list">
              {tagMap.get('founder-special')?.slice(0, 4).map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`}>
                    <span class="post-title-text">{p.data.title}</span>
                    <span class="read-time">{readingTime(p.body)}m read</span>
                  </a>
                </li>
              ))}
            </ul>

            <a href="/tags/founder-special/" class="special-view-link special-view-link--orange">
              View Founder's Playbook &rarr;
            </a>
          </div>
        )}

        <!-- PERFORMANCE SPECIAL -->
        {tagMap.has('performance-special') && (
          <div class="special-card special-card--purple" id="performance-card">
            <div class="special-card-header">
              <span class="badge-pill badge-pill--purple">PERFORMANCE SPECIAL</span>
              <span class="count-pill">{tagMap.get('performance-special')?.length} Articles</span>
            </div>
            <h3>Performance & System Architecture</h3>
            <p>Deep dives into distributed schedulers, verdict engines, probe fleets, Linux systemd checks, and cloud VM setup.</p>
            
            <ul class="special-post-list">
              {tagMap.get('performance-special')?.slice(0, 4).map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`}>
                    <span class="post-title-text">{p.data.title}</span>
                    <span class="read-time">{readingTime(p.body)}m read</span>
                  </a>
                </li>
              ))}
            </ul>

            <a href="/tags/performance-special/" class="special-view-link special-view-link--purple">
              View All Performance Specials &rarr;
            </a>
          </div>
        )}

      </div>
    </section>

    <!-- ALL TOPICS GRID -->
    <section class="topics-section">
      <h2 class="section-heading">All Topics</h2>
      <div class="topics-grid">
        {topicTags.map((tag) => {
          const tagPosts = tagMap.get(tag) || [];
          return (
            <div class="topic-card">
              <div class="topic-card-top">
                <a href={`/tags/${encodeURIComponent(tag)}/`} class="topic-tag-name">
                  #{tag}
                </a>
                <span class="topic-count-pill">{tagPosts.length} {tagPosts.length === 1 ? 'article' : 'articles'}</span>
              </div>

              <ul class="topic-post-list">
                {tagPosts.slice(0, 3).map((p) => (
                  <li>
                    <a href={`/blog/${p.slug}/`}>
                      {p.data.title}
                    </a>
                  </li>
                ))}
              </ul>

              <a href={`/tags/${encodeURIComponent(tag)}/`} class="topic-card-link">
                View all in #{tag} &rarr;
              </a>
            </div>
          );
        })}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .tags-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 24px;
  }

  /* Header */
  .tags-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--hairline);
  }
  .tags-eyebrow {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-quaternary);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .square-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    display: inline-block;
  }
  .eyebrow-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--hairline);
  }
  .tags-header h1 {
    font-size: 36px;
    font-weight: 800;
    margin: 0 0 12px 0;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .tags-subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    margin: 0 0 24px 0;
    max-width: 680px;
    line-height: 1.5;
  }

  .tags-stats-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .stat-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    background: var(--surface-raised);
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--hairline);
  }
  .stat-num {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .stat-lbl {
    font-size: 13px;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  /* Section Headings */
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .section-heading {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .swipe-indicator {
    display: none;
    font-size: 11px;
    font-weight: 800;
    color: #0F172A;
    background: #F9B900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-items: center;
    gap: 4px;
    border: none;
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .swipe-indicator:active {
    background: #E5A900;
    transform: scale(0.95);
  }

  /* Specials Section */
  .specials-section {
    margin-bottom: 56px;
  }
  .specials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .special-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .special-card--orange {
    border: 2px solid #F9B900;
  }
  .special-card--purple {
    border: 2px solid #8338EC;
  }

  .special-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .badge-pill {
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge-pill--orange {
    background: #F9B900;
    color: #0F172A;
  }
  .badge-pill--purple {
    background: #8338EC;
    color: #ffffff;
  }
  .count-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-quaternary);
    font-weight: 600;
  }

  .special-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #111827;
  }
  .special-card p {
    font-size: 14px;
    color: #4B5563;
    margin: 0 0 20px 0;
    line-height: 1.45;
  }

  .special-post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid #F1F5F9;
    padding-top: 16px;
  }
  .special-post-list li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: #1E293B;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .special-card--orange .special-post-list li a:hover {
    color: #D97706;
  }
  .special-card--purple .special-post-list li a:hover {
    color: #8338EC;
  }
  .post-title-text {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 12px;
  }
  .read-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #94A3B8;
    flex-shrink: 0;
  }

  .special-view-link {
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
  }
  .special-view-link--orange {
    color: #D97706;
  }
  .special-view-link--purple {
    color: #8338EC;
  }
  .special-view-link:hover {
    text-decoration: underline;
  }

  /* Topics Grid */
  .topics-section {
    margin-bottom: 60px;
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .topic-card {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .topic-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .topic-tag-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: #0F172A;
    text-decoration: none;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 4px 10px;
    border-radius: 6px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .topic-tag-name:hover {
    color: #D97706;
    border-color: #CBD5E1;
  }
  .topic-count-pill {
    font-size: 11px;
    color: #64748B;
    font-weight: 600;
  }

  .topic-post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .topic-post-list li a {
    text-decoration: none;
    color: #334155;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }
  .topic-post-list li a:hover {
    color: #0F172A;
  }

  .topic-card-link {
    font-size: 13px;
    font-weight: 600;
    color: #D97706;
    text-decoration: none;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed #E2E8F0;
  }
  .topic-card-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .swipe-indicator {
      display: inline-flex;
    }
    .specials-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 16px;
      gap: 48px;
      -ms-overflow-style: none;
      scrollbar-width: none;
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 50px;
      padding-right: 50px;
    }
    .specials-grid::-webkit-scrollbar {
      display: none;
    }
    .special-card {
      flex: 0 0 calc(100vw - 100px);
      max-width: 340px;
      scroll-snap-align: center;
    }
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .topics-grid {
      grid-template-columns: 1fr;
    }
    .special-card {
      padding: 20px;
    }
    .tags-container {
      padding: 0 16px;
    }
    .specials-grid {
      margin-left: -16px;
      margin-right: -16px;
      padding-left: 50px;
      padding-right: 50px;
      gap: 32px;
    }
    .special-card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  const swipeBtn = document.getElementById('swipe-btn');
  const performanceCard = document.getElementById('performance-card');
  const specialsGrid = document.querySelector('.specials-grid');
  
  if (swipeBtn && performanceCard && specialsGrid) {
    swipeBtn.addEventListener('click', () => {
      specialsGrid.scrollTo({
        left: performanceCard.offsetLeft - 16,
        behavior: 'smooth'
      });
    });
  }
</script>

