---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MetricsBar from "../components/MetricsBar.astro";
import FeatureSection from "../components/FeatureSection.astro";
import LiveMonitoring from "../components/LiveMonitoring.astro";
import WhyWhatPing from "../components/WhyWhatPing.astro";
import MonitoringTypes from "../components/MonitoringTypes.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ProofMetrics from "../components/ProofMetrics.astro";
import HumanAgentSection from "../components/HumanAgentSection.astro";
import FinalCTA from "../components/FinalCTA.astro";

const title = "WhatPing — uptime monitoring that watches your certificate, domain and DNS";
const description = "Free uptime monitoring for HTTP, TCP and cron jobs — plus TLS expiry, domain registration, DNS records and SPF/DMARC. Alerts by email, webhook, ntfy or Telegram.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "WhatPing",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD"
  }
};
---

<Base title={title} description={description} jsonLd={jsonLd} isHome={true}>
  <Hero />
  <MetricsBar />
  <FeatureSection />
  <LiveMonitoring />
  <WhyWhatPing />
  <MonitoringTypes />
  <HowItWorks />
  <ProofMetrics />
  <HumanAgentSection />
  <FinalCTA />
</Base>
