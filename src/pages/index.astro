---
import Bento from "../components/Bento.astro";
import StatusCard from "../components/StatusCard.astro";
import Base from "../layouts/Base.astro";
import { APP_URL, SITE_URL } from "../lib/site";

const title =
  "WhatPing — uptime monitoring that watches your certificate, domain and DNS";
const description =
  "Free uptime monitoring for HTTP, TCP and cron jobs — plus TLS expiry, domain registration, DNS records and SPF/DMARC. Alerts by email, webhook, ntfy or Telegram.";

const gaps = [
  {
    tag: "Registration lapsed",
    h: "Your domain expires on a Sunday",
    p: "The registrar pulls the nameservers, the zone stops resolving, and every service on the domain disappears at once. Email included, so you may not even get told.",
  },
  {
    tag: "Certificate expired",
    h: "Not down. Worse than down.",
    p: "Browsers show an interstitial, API clients throw TLS errors, mobile apps fail silently. The server is fine, and it will keep telling you so.",
  },
  {
    tag: "SPF broken",
    h: "Your mail starts landing in spam",
    p: "Including the alert emails that were supposed to tell you something is wrong. The monitoring is up. The path from the monitoring to you is not.",
  },
];

// Wide cells are the two things nothing else in this category does.
const monitorCells = [
  {
    tag: "Domain",
    title: "Registration expiry, read from the registry",
    body: "An expired domain takes down every service on it at once — including the email that would have warned you. Uptime Kuma has no equivalent.",
    href: "/features/domain-expiry-monitoring/",
    wide: true,
    accent: true,
  },
  {
    tag: "Email auth",
    title: "SPF and DMARC, checked daily",
    body: "Break SPF and your mail lands in spam — including your own alerts. Nothing else in this category watches the path your alerts travel down.",
    href: "/features/email-auth-monitoring/",
    wide: true,
    accent: true,
  },
  {
    tag: "HTTP",
    title: "Status ranges and keyword assertions",
    body: "For when 200 is a lie.",
    href: "/features/uptime-monitoring/",
  },
  {
    tag: "TCP",
    title: "Port accepts a connection",
    body: "Databases, SMTP, anything without HTTP.",
    href: "/features/uptime-monitoring/",
  },
  {
    tag: "Heartbeat",
    title: "Your cron job pings on success",
    body: "We alert when it stops arriving.",
    href: "/features/heartbeat-monitoring/",
  },
  {
    tag: "Certificate",
    title: "Days until TLS expiry",
    body: "Checked daily, threshold you set.",
    href: "/features/certificate-monitoring/",
  },
  {
    tag: "DNS",
    title: "A, AAAA, MX, TXT, CNAME, NS",
    body: "Assert a record still says what it should.",
    href: "/features/dns-monitoring/",
    wide: true,
  },
];

const proof = [
  {
    h: "It monitors its own prober",
    p: "A heartbeat monitor watches the probe worker, so if the worker dies the system tells you rather than going quiet. Not theoretical — it caught a parsing bug that froze the worker on a stale configuration, and it was the only signal anything was wrong.",
    href: "/docs/monitors/heartbeat/",
  },
  {
    h: "A broken channel cannot corrupt monitoring",
    p: "Delivery is attempted after state is already committed, and every attempt is recorded. A webhook returning 500 forever will never make a monitor look up or down.",
    href: "/docs/alerting/channels/",
  },
  {
    h: "A retry cannot double-page you",
    p: "Every check result carries a producer-generated ID, so a replay after a network blip is discarded rather than opening a second incident.",
    href: "/docs/concepts/",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WhatPing",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  url: SITE_URL,
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero band--dark">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="hero__badge">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          Free while in beta · no card
        </p>

        <h1 class="hero__h1">
          The outage that returns <span class="hero__200">200</span> right up until
          it doesn&rsquo;t
        </h1>

        <p class="lede hero__lede">
          Your certificate expires. Your domain registration lapses. Someone edits
          a DNS record. Your SPF breaks and your email stops arriving. A health
          check sees none of it — and then everything is down at once.
        </p>

        <div class="hero__cta">
          <a class="btn btn--primary" href={APP_URL}>Start monitoring — free</a>
          <a class="btn btn--secondary" href="/how-it-works/">See how it works</a>
        </div>

        <p class="hero__meta">
          20 monitors per workspace · checks from 20 seconds · one probe location
        </p>
      </div>

      <div class="hero__visual">
        <StatusCard />
      </div>
    </div>
  </section>

  <!-- The gap -->
  <section class="band">
    <div class="shell">
      <p class="eyebrow reveal">01 — The gap</p>
      <h2 class="band__h reveal">
        Four outages your health check will never predict
      </h2>

      <div class="gaps">
        {
          gaps.map((g, i) => (
            <article class="gap reveal" style={`--i:${i}`}>
              <span class="pill pill--down gap__tag">{g.tag}</span>
              <h3 class="gap__h">{g.h}</h3>
              <p class="gap__p">{g.p}</p>
              <p class="gap__foot">A health check would have returned 200 the whole time.</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Monitor types, bento -->
  <section class="band">
    <div class="shell">
      <p class="eyebrow reveal">02 — Monitor types</p>
      <h2 class="band__h reveal">Seven things worth watching</h2>
      <Bento cells={monitorCells} />
    </div>
  </section>

  <!-- Alerting -->
  <section class="band">
    <div class="shell">
      <p class="eyebrow reveal">03 — Alerting</p>
      <h2 class="band__h reveal">
        Alerts that keep working when the first one doesn&rsquo;t
      </h2>

      <div class="split">
        <div class="reveal">
          <p>
            Email, webhook, ntfy and Telegram. The webhook payload carries
            <code>text</code> and <code>content</code> aliases, so one endpoint works
            for Slack, Discord, Mattermost and plain automation receivers without
            per-provider setup.
          </p>
          <p>
            <strong>Reminders while you are still down.</strong> Most tools alert
            once, on the transition. If that message fails to deliver, a six-hour
            outage is indistinguishable from everything being fine.
          </p>
          <p>
            <strong>A second opinion.</strong> When a check fails, WhatPing asks a
            network that isn&rsquo;t ours whether it agrees, and says so in the alert.
            &ldquo;The site is down&rdquo; and &ldquo;<em>we</em> can&rsquo;t reach
            the site&rdquo; are different problems.
          </p>
          <p><a href="/features/alerting/">How alerting works →</a></p>
        </div>

        <figure class="terminal surface--terminal reveal">
          <figcaption>alert stream</figcaption>
          <pre><code><span class="t-down">🔴 DOWN</span> — api (https://api.example.com):
connect failed: Connection refused (os error 111)

<span class="t-down">🔴 STILL DOWN (1h 35m)</span> — api:
connect failed: Connection refused (os error 111)
<span class="t-dim">· confirmed unreachable from a second network</span>

<span class="t-up">🟢 RECOVERED</span> — api after 5820s</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="band">
    <div class="shell">
      <p class="eyebrow reveal">04 — How it works</p>
      <h2 class="band__h reveal">Three moving parts</h2>

      <ol class="steps">
        <li class="reveal" style="--i:0">
          <span>01</span>
          <div>
            <strong>A stateless Rust prober</strong> runs the checks. It holds no
            state of its own, so it can be restarted mid-outage without losing or
            duplicating anything.
          </div>
        </li>
        <li class="reveal" style="--i:1">
          <span>02</span>
          <div>
            <strong>A backend that owns every decision.</strong> The prober reports
            raw observations; whether that means &ldquo;down&rdquo; is decided in one
            place, against your threshold.
          </div>
        </li>
        <li class="reveal" style="--i:2">
          <span>03</span>
          <div>
            <strong>Certificate, domain, DNS and email checks run daily</strong>,
            because a certificate does not stop being valid between one minute and
            the next.
          </div>
        </li>
      </ol>

      <p class="band__link"><a href="/how-it-works/">The architecture in detail →</a></p>
    </div>
  </section>

  <!-- Proof -->
  <section class="band">
    <div class="shell">
      <p class="eyebrow reveal">05 — Proof</p>
      <h2 class="band__h reveal">No testimonials. Here is what you can check instead.</h2>

      <div class="proof">
        {
          proof.map((item, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <h3 class="proof__h">{item.h}</h3>
              <p class="proof__p">{item.p}</p>
              <p>
                <a href={item.href}>Read the docs →</a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="band band--last band--dark">
    <div class="shell">
      <div class="final panel reveal">
        <h2 class="final__h">Start with the one you keep forgetting</h2>
        <p class="final__p">
          Add a domain expiry monitor. Thirty seconds, no cost, and it covers the
          failure that no amount of health checking will ever warn you about.
        </p>
        <p class="hero__cta">
          <a class="btn btn--primary" href={APP_URL}>Start monitoring — free</a>
          <a class="btn btn--secondary" href="/docs/">Read the docs</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- hero --- */
  /* Full-bleed black band inside a cream page — the reference's core move. */
  .hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 var(--space-section);
    background:
      radial-gradient(
        70rem 38rem at 22% -18%,
        var(--accent-glow),
        transparent 60%
      ),
      var(--surface-canvas);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--space-md);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-tertiary);
  }
  .hero__badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero__h1 {
    font-size: var(--size-display-xl);
    letter-spacing: var(--track-display);
    line-height: 1.02;
    max-width: 15ch;
  }
  .hero__200 {
    font-family: var(--font-mono);
    font-size: 0.78em;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .hero__lede {
    margin: var(--space-md) 0 0;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-lg) 0 0;
  }

  .hero__meta {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary);
  }

  @media (max-width: 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__h1 {
      max-width: 18ch;
    }
  }

  /* --- bands --- */
  .band {
    padding: var(--space-section) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .band--last {
    border-bottom: 0;
    padding-bottom: var(--space-2xl);
  }
  .band__h {
    max-width: 22ch;
    margin-bottom: var(--space-lg);
  }
  .band__link {
    margin-top: var(--space-md);
    font-size: var(--size-small);
  }
  .band p {
    color: var(--text-tertiary);
  }

  /* --- the gap --- */
  .gaps {
    display: grid;
    gap: var(--space-2xs);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .gap {
    padding: var(--space-md);
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }
  .gap__tag {
    align-self: flex-start;
  }
  .gap__h {
    margin: var(--space-xs) 0 var(--space-2xs);
    font-size: var(--size-body-lg);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .gap__p {
    margin: 0;
    font-size: var(--size-small);
    color: var(--text-tertiary);
  }
  .gap__foot {
    margin: var(--space-sm) 0 0;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary) !important;
  }

  /* --- alerting --- */
  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: start;
  }
  .split p + p {
    margin-top: var(--space-sm);
  }
  @media (max-width: 58rem) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Colours come from .surface--terminal in tokens.css; this is shape only. */
  .terminal {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .terminal figcaption {
    padding: var(--space-2xs) var(--space-sm);
    border-bottom: 1px solid var(--hairline);
    background: var(--surface-raised);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-quaternary);
  }
  .terminal pre {
    margin: 0;
    padding: var(--space-sm);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    line-height: 1.8;
    color: var(--text-tertiary);
  }
  .t-down {
    color: var(--status-down);
  }
  .t-up {
    color: var(--status-up);
  }
  .t-dim {
    color: var(--text-quaternary);
  }

  /* --- steps --- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .steps li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, var(--measure));
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--hairline);
    color: var(--text-tertiary);
  }
  .steps span {
    font-family: var(--font-mono);
    font-size: var(--size-small);
    color: var(--text-quaternary);
  }
  @media (max-width: 40rem) {
    .steps li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }
  }

  /* --- proof --- */
  .proof {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .proof__h {
    margin-bottom: var(--space-2xs);
    font-size: var(--size-body);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-body);
    color: var(--text-primary);
  }
  .proof__p {
    margin: 0 0 var(--space-2xs);
    font-size: var(--size-small);
  }
  .proof a {
    font-size: var(--size-small);
  }

  /* --- final --- */
  .final {
    padding: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    border: 0;
    box-shadow: none;
    background:
      radial-gradient(44rem 22rem at 50% 130%, var(--accent-glow), transparent 68%),
      var(--surface-raised);
    border-radius: var(--radius-2xl);
  }
  .final__h {
    margin-inline: auto;
    max-width: 20ch;
  }
  .final__p {
    margin: var(--space-sm) auto 0;
    max-width: 46ch;
    color: var(--text-tertiary);
  }
  .final .hero__cta {
    justify-content: center;
  }

  /* Stagger reveals within a group. */
  .reveal {
    animation-delay: calc(var(--i, 0) * 60ms);
  }
</style>
