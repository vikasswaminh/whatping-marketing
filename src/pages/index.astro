---
import Bento from "../components/Bento.astro";
import Section from "../components/Section.astro";
import StatusCard from "../components/StatusCard.astro";
import Base from "../layouts/Base.astro";
import { APP_URL, SITE_URL } from "../lib/site";

const title =
  "WhatPing — uptime monitoring that watches your certificate, domain and DNS";
const description =
  "Free uptime monitoring for HTTP, TCP and cron jobs — plus TLS expiry, domain registration, DNS records and SPF/DMARC. Alerts by email, webhook, ntfy or Telegram.";

const gaps = [
  {
    tag: "Registration lapsed",
    h: "Your domain expires on a Sunday",
    p: "The registrar pulls the nameservers, the zone stops resolving, and every service on the domain disappears at once. Email included, so you may not even get told.",
  },
  {
    tag: "Certificate expired",
    h: "Not down. Worse than down.",
    p: "Browsers show an interstitial, API clients throw TLS errors, mobile apps fail silently. The server is fine, and it will keep telling you so.",
  },
  {
    tag: "SPF broken",
    h: "Your mail starts landing in spam",
    p: "Including the alert emails that were supposed to tell you something is wrong. The monitoring is up. The path from the monitoring to you is not.",
  },
];

// A uniform 3×4 field: the three differentiators lead as an accented top row, then
// nine standard types below. Every cell is the same size — the grid is symmetric and
// the editorial weight comes from the accent edge, not from cell size.
const monitorCells = [
  {
    tag: "Domain",
    title: "Registration expiry",
    body: "An expired domain takes every service down at once. Uptime Kuma has no equivalent.",
    href: "/features/domain-expiry-monitoring/",
    accent: true,
  },
  {
    tag: "Email auth",
    title: "SPF and DMARC, daily",
    body: "Break SPF and your mail — including your own alerts — lands in spam.",
    href: "/features/email-auth-monitoring/",
    accent: true,
  },
  {
    tag: "API",
    title: "Create from your pipeline",
    body: "Bearer keys, scopes, idempotency. Same validator as the dashboard.",
    href: "/features/api/",
    accent: true,
  },
  {
    tag: "HTTP",
    title: "Status ranges + keyword",
    body: "For when 200 is a lie.",
    href: "/features/uptime-monitoring/",
  },
  {
    tag: "TCP",
    title: "Port accepts a connection",
    body: "Databases, brokers, anything without HTTP.",
    href: "/features/uptime-monitoring/",
  },
  {
    tag: "Heartbeat",
    title: "Your cron pings on success",
    body: "We alert when it stops arriving.",
    href: "/features/heartbeat-monitoring/",
  },
  {
    tag: "Certificate",
    title: "Days until TLS expiry",
    body: "Checked daily, threshold you set.",
    href: "/features/certificate-monitoring/",
  },
  {
    tag: "DNS",
    title: "A, AAAA, MX, TXT, CNAME, NS",
    body: "Assert a record still says what it should.",
    href: "/features/dns-monitoring/",
  },
  {
    tag: "ICMP",
    title: "Packet loss + median RTT",
    body: "Unprivileged. No root, no CAP_NET_RAW.",
    href: "/features/ping-monitoring/",
  },
  {
    tag: "UDP",
    title: "A request, a required reply",
    body: "DNS, NTP, STUN. No port-open guessing.",
    href: "/features/udp-monitoring/",
  },
  {
    tag: "gRPC",
    title: "Health must say SERVING",
    body: "A bound port is not a ready service.",
    href: "/features/grpc-monitoring/",
  },
  {
    tag: "SMTP · IMAP",
    title: "Greeting plus STARTTLS",
    body: "Where an expired cert on 587 shows up.",
    href: "/features/smtp-imap-monitoring/",
  },
];

const steps = [
  {
    n: "01",
    h: "A stateless Rust prober",
    p: "runs the checks. It holds no state, so it can be restarted mid-outage without losing or duplicating anything.",
  },
  {
    n: "02",
    h: "A backend owns every decision",
    p: "The prober reports raw observations; whether that means “down” is decided in one place, against your threshold.",
  },
  {
    n: "03",
    h: "Intelligence runs daily",
    p: "Certificate, domain, DNS and email checks run once a day — a certificate does not stop being valid between one minute and the next.",
  },
];

const proof = [
  {
    h: "It monitors its own prober",
    p: "A heartbeat watches the probe worker, so if the worker dies the system tells you rather than going quiet. It once caught a parsing bug that froze the worker on a stale config.",
    href: "/docs/monitors/heartbeat/",
  },
  {
    h: "A broken channel cannot corrupt monitoring",
    p: "Delivery is attempted after state is committed, and every attempt is recorded. A webhook returning 500 forever never makes a monitor look up or down.",
    href: "/docs/alerting/channels/",
  },
  {
    h: "A retry cannot double-page you",
    p: "Every check result carries a producer-generated ID, so a replay after a network blip is discarded rather than opening a second incident.",
    href: "/docs/concepts/",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "WhatPing",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  url: SITE_URL,
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero — centred on the axis -->
  <section class="hero ruled">
    <div class="shell hero__inner">
      <p class="hero__badge">
        <span class="hero__badge-dot" aria-hidden="true"></span>
        Free while in beta · no card
      </p>

      <h1 class="hero__h1">
        The outage that returns <span class="readout"
          ><span class="readout__label" aria-hidden="true">HTTP</span><span
            class="readout__value">200</span
          ><span class="readout__caret" aria-hidden="true"></span></span
        > right up until it doesn&rsquo;t
      </h1>

      <p class="lede hero__lede">
        Your certificate expires. Your domain registration lapses. Someone edits a
        DNS record. Your SPF breaks and your email stops arriving. A health check
        sees none of it — and then everything is down at once.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href={APP_URL}>Start monitoring — free</a>
        <a class="btn btn--secondary" href="/how-it-works/">See how it works</a>
      </div>

      <p class="hero__meta">
        20 monitors per workspace · checks from 20 seconds · one probe location
      </p>

      <div class="hero__visual">
        <StatusCard />
      </div>
    </div>
  </section>

  <!-- 01 — The gap -->
  <Section
    eyebrow="01 — The gap"
    title="Four outages your health check will never predict"
    align="center"
  >
    <div class="gaps">
      {
        gaps.map((g, i) => (
          <article class="gap reveal" style={`--i:${i}`}>
            <span class="pill pill--down gap__tag">{g.tag}</span>
            <h3 class="gap__h">{g.h}</h3>
            <p class="gap__p">{g.p}</p>
            <p class="gap__foot">A health check would have returned 200 the whole time.</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- 02 — Monitor types -->
  <Section
    eyebrow="02 — Monitor types"
    title="Everything worth watching"
    align="center"
  >
    <Bento cells={monitorCells} />
  </Section>

  <!-- 03 — Alerting -->
  <Section
    eyebrow="03 — Alerting"
    title="Alerts that keep working when the first one doesn&rsquo;t"
    align="center"
  >
    <div class="split">
      <div class="reveal">
        <p>
          Email, webhook, ntfy and Telegram. The webhook payload carries
          <code>text</code> and <code>content</code> aliases, so one endpoint works
          for Slack, Discord, Mattermost and plain automation receivers without
          per-provider setup.
        </p>
        <p>
          <strong>Reminders while you are still down.</strong> Most tools alert once,
          on the transition. If that message fails to deliver, a six-hour outage is
          indistinguishable from everything being fine.
        </p>
        <p>
          <strong>A second opinion.</strong> When a check fails, WhatPing asks a
          network that isn&rsquo;t ours whether it agrees, and says so in the alert.
        </p>
        <p><a href="/features/alerting/">How alerting works →</a></p>
      </div>

      <figure class="terminal reveal">
        <figcaption>alert stream</figcaption>
        <pre><code><span class="t-down">🔴 DOWN</span> — api (https://api.example.com):
connect failed: Connection refused (os error 111)

<span class="t-down">🔴 STILL DOWN (1h 35m)</span> — api:
connect failed: Connection refused (os error 111)
<span class="t-dim">· confirmed unreachable from a second network</span>

<span class="t-up">🟢 RECOVERED</span> — api after 5820s</code></pre>
      </figure>
    </div>
  </Section>

  <!-- 04 — How it works -->
  <Section
    eyebrow="04 — How it works"
    title="Three moving parts"
    align="center"
  >
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="steps__num">{s.n}</span>
            <strong class="steps__h">{s.h}</strong>
            <span class="steps__p">{s.p}</span>
          </li>
        ))
      }
    </ol>
    <p class="band__link band__link--center">
      <a href="/how-it-works/">The architecture in detail →</a>
    </p>
  </Section>

  <!-- 05 — Proof -->
  <Section
    eyebrow="05 — Proof"
    title="No testimonials. Here is what you can check instead."
    align="center"
  >
    <div class="proof">
      {
        proof.map((item, i) => (
          <div class="proof__item reveal" style={`--i:${i}`}>
            <h3 class="proof__h">{item.h}</h3>
            <p class="proof__p">{item.p}</p>
            <p>
              <a href={item.href}>Read the docs →</a>
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Final CTA -->
  <Section last>
    <div class="final reveal">
      <h2 class="final__h">Start with the one you keep forgetting</h2>
      <p class="final__p">
        Add a domain expiry monitor. Thirty seconds, no cost, and it covers the
        failure that no amount of health checking will ever warn you about.
      </p>
      <p class="hero__cta">
        <a class="btn btn--primary" href={APP_URL}>Start monitoring — free</a>
        <a class="btn btn--secondary" href="/docs/">Read the docs</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  /* Section/band styling is global (global.css). Everything below is homepage-local.
     The page is composed on a single vertical axis: every section header is centred
     and every content field is a symmetric, equal-column grid. */

  /* --- hero: centred --- */
  .hero {
    padding: clamp(3rem, 7vw, 5.5rem) 0 var(--space-section);
    border-bottom: 1px solid var(--hairline);
    text-align: center;
    background:
      radial-gradient(60rem 32rem at 50% -20%, var(--accent-glow), transparent 62%),
      var(--surface-canvas);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 var(--space-lg);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-stretch: var(--width-ui);
    font-size: var(--size-eyebrow);
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }
  .hero__badge-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
  .hero__h1 {
    max-width: 20ch;
    margin-inline: auto;
    font-size: var(--size-display-xl);
    letter-spacing: var(--track-display);
    line-height: 1.12;
    text-wrap: balance;
  }
  .readout {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.06em 0.42em 0.1em;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-xs);
    background: var(--accent-soft);
    font-size: 0.74em;
    vertical-align: baseline;
    translate: 0 0.04em;
  }
  .readout__label {
    font-family: var(--font-mono);
    font-size: 0.5em;
    letter-spacing: 0.16em;
    color: var(--text-quaternary);
  }
  .readout__value {
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    letter-spacing: -0.02em;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
  .readout__caret {
    width: 0.42em;
    height: 0.92em;
    background: var(--accent);
    animation: caret 1.15s steps(1) infinite;
  }
  @keyframes caret {
    50% { opacity: 0; }
  }
  .hero__lede {
    margin: var(--space-md) auto 0;
    text-align: center;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin: var(--space-lg) 0 0;
  }
  .hero__meta {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary);
  }
  /* The instrument sits centred below the copy — framed by the shell, not bled past it. */
  .hero__visual {
    width: 100%;
    max-width: 64rem;
    margin: var(--space-2xl) auto 0;
  }
  @media (max-width: 62rem) {
    .hero {
      padding-top: clamp(2rem, 5vw, 3.5rem);
      padding-bottom: clamp(2.5rem, 6vw, 4rem);
    }
    .hero__h1 {
      max-width: 18ch;
      font-size: clamp(1.85rem, 0.9rem + 4.2vw, 2.75rem);
    }
    .hero__visual {
      margin-top: var(--space-xl);
    }
  }

  /* --- 01 the gap: three equal, centred bays --- */
  .gaps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .gap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    background: var(--surface-canvas);
  }
  .gap__h {
    margin: var(--space-sm) 0 var(--space-2xs);
    font-size: var(--size-body-lg);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-title);
    color: var(--text-primary);
  }
  .gap__p {
    margin: 0;
    font-size: var(--size-small);
    color: var(--text-tertiary);
  }
  .gap__foot {
    width: 100%;
    margin: var(--space-md) 0 0;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--text-quaternary) !important;
  }
  @media (max-width: 52rem) {
    .gaps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- 03 alerting: two equal halves --- */
  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    text-align: left;
  }
  .split p + p {
    margin-top: var(--space-sm);
  }
  @media (max-width: 58rem) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .terminal {
    margin: 0;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    background: var(--surface-sunken);
    overflow: hidden;
  }
  .terminal figcaption {
    padding: var(--space-2xs) var(--space-sm);
    border-bottom: 1px solid var(--hairline-strong);
    background: var(--surface-overlay);
    font-family: var(--font-display);
    font-stretch: var(--width-ui);
    font-size: var(--size-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--text-quaternary);
  }
  .terminal pre {
    margin: 0;
    padding: var(--space-sm);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    line-height: 1.8;
    color: var(--text-tertiary);
  }
  .t-down { color: var(--status-down); }
  .t-up { color: var(--status-up); }
  .t-dim { color: var(--text-quaternary); }

  /* --- 04 how it works: three equal, centred steps --- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .steps li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-xl) var(--space-md);
    background: var(--surface-canvas);
  }
  .steps__num {
    font-family: var(--font-mono);
    font-size: var(--size-display-md);
    line-height: 1;
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }
  .steps__h {
    margin-top: var(--space-2xs);
    font-size: var(--size-body-lg);
    font-weight: var(--weight-strong);
    letter-spacing: var(--track-title);
    color: var(--text-primary);
  }
  .steps__p {
    font-size: var(--size-small);
    color: var(--text-tertiary);
    max-width: 34ch;
  }
  .band__link--center {
    text-align: center;
  }
  @media (max-width: 52rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- 05 proof: three equal, centred --- */
  .proof {
    display: grid;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .proof__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    background: var(--surface-canvas);
  }
  .proof__h {
    margin-bottom: var(--space-2xs);
    font-size: var(--size-body);
    font-weight: var(--weight-strong);
    color: var(--text-primary);
  }
  .proof__p {
    margin: 0 0 var(--space-sm);
    font-size: var(--size-small);
  }
  .proof a {
    font-size: var(--size-small);
  }
  @media (max-width: 52rem) {
    .proof {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- final CTA --- */
  .final {
    padding: clamp(2.5rem, 6vw, 4rem) var(--space-md);
    text-align: center;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-xs);
    background:
      radial-gradient(38rem 20rem at 50% 128%, var(--accent-glow), transparent 66%),
      var(--surface-raised);
  }
  .final__h {
    margin-inline: auto;
    max-width: 22ch;
  }
  .final__p {
    margin: var(--space-sm) auto 0;
    max-width: 46ch;
    color: var(--text-tertiary);
  }
  .final .hero__cta {
    justify-content: center;
    margin-top: var(--space-lg);
  }

  .reveal {
    animation-delay: calc(var(--i, 0) * 60ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .readout__caret { animation: none; }
  }
</style>
