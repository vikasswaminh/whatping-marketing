---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Callout from "../../components/Callout.astro";
import Docs from "../../layouts/Docs.astro";
import { SITE_URL, normalize } from "../../lib/site";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => {
    // "/docs" itself has no rest segment; Astro wants `undefined`, not "".
    const rest = normalize(entry.data.route)
      .replace(/^\/docs\/?/, "")
      .replace(/\/$/, "");
    return {
      params: { slug: rest === "" ? undefined : rest },
      props: { entry },
    };
  });
}

const { entry } = Astro.props as { entry: CollectionEntry<"docs"> };
const { Content, headings } = await render(entry);

/**
 * FAQPage markup for /docs/faq, derived from the page body rather than maintained beside it.
 *
 * Google requires the answer text to match what a reader sees; hand-written JSON-LD drifts
 * from the prose on the first edit and then makes a claim the page does not. Parsing the
 * source means the two cannot disagree.
 *
 * Each `## ` heading is a question and everything up to the next `##` is its answer, with
 * markdown syntax stripped to plain text. Fenced code blocks are dropped — a code sample is
 * not an answer a search result can render.
 */
function faqJsonLd(body: string) {
  const sections = body.split(/^## /m).slice(1);
  const entries = sections.flatMap((section) => {
    const [heading, ...rest] = section.split("\n");
    const question = heading.trim();
    const answer = rest
      .join("\n")
      .replace(/```[\s\S]*?```/g, "")
      .replace(/^\s*[-*]\s+/gm, "")
      .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
      .replace(/[*_`]/g, "")
      .replace(/\s+/g, " ")
      .trim();
    // A question with no prose answer would produce an empty entry, which is an invalid
    // FAQPage rather than a partial one.
    if (!question || answer.length < 20) return [];
    return [
      {
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      },
    ];
  });

  if (entries.length === 0) return undefined;
  return {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    url: new URL(normalize(entry.data.route), SITE_URL).href,
    mainEntity: entries,
  };
}

const jsonLd =
  normalize(entry.data.route) === "/docs/faq/" && entry.body
    ? faqJsonLd(entry.body)
    : undefined;
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  h1={entry.data.h1}
  headings={headings}
  jsonLd={jsonLd}
>
  <Content components={{ Callout }} />
</Docs>
